# =========================================================================================
# 🔐 CẤU HÌNH BIẾN MÔI TRƯỜNG ĐĂNG NHẬP OTP QUA EMAIL (GMAIL SMTP)
# =========================================================================================

# 1. Cổng máy chủ Backend (mặc định: 5000)
PORT=5000

# 2. Địa chỉ Gmail dùng để gửi mã OTP
EMAIL_USER=your_email@gmail.com

# 3. Mật khẩu ứng dụng 16 ký tự của Gmail (App Password)
# 👉 Lưu ý: Đây KHÔNG PHẢI mật khẩu đăng nhập Gmail thường!
# Xem hướng dẫn lấy tại: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your_16_digit_app_password

# 4. Khóa bí mật ký JWT Token
JWT_SECRET=focusflow_super_secret_jwt_key_2026

# 5. URL Frontend cho phép CORS
CLIENT_URL=http://localhost:5173
